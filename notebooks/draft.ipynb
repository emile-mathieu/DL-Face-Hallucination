#specific datapreprocessing for test data only 
class FixedTestFaceDataset(Dataset):
    def __init__(
        self,
        image_paths: List[str],
        mean,
        std,
        blur_type="gaussian",
        gaussian_sigma=None,
        motion_length=None,
        base_seed=42,
    ):
        self.image_paths = image_paths
        self.hr_size = HR_SIZE
        self.fixed_lr_size = TEST_FIXED_LR_SIZE
        self.nn_input_size = TEST_NN_INPUT_SIZE

        self.blur_type = blur_type
        self.gaussian_sigma = gaussian_sigma
        self.motion_length = motion_length
        self.base_seed = base_seed

        self.mean = np.array(mean, dtype=np.float32).reshape(1, 1, 3)
        self.std = np.array(std, dtype=np.float32).reshape(1, 1, 3)
        self.mean_torch = torch.tensor(mean, dtype=torch.float32).view(3, 1, 1)
        self.std_torch = torch.tensor(std, dtype=torch.float32).view(3, 1, 1)
        self.eps = 1e-6

        if blur_type == "gaussian" and gaussian_sigma is None:
            raise ValueError("gaussian_sigma must be provided for gaussian blur")
        if blur_type == "motion" and motion_length is None:
            raise ValueError("motion_length must be provided for motion blur")

    def __len__(self):
        return len(self.image_paths)

    def __getitem__(self, idx):
        path = self.image_paths[idx]
        img = Image.open(path).convert("RGB")

        hr_img = img.resize(self.hr_size, Image.BICUBIC)
        ih = np.array(hr_img).astype(np.float32) / 255.0

        fixed_lr = self.fixed_test_preprocessing(img, idx)
        iin = self.nn_preprocessing(fixed_lr)
        ih = self.normalize(ih)

        iin = torch.from_numpy(iin).permute(2, 0, 1).float()
        ih = torch.from_numpy(ih).permute(2, 0, 1).float()
        return iin, ih

    def fixed_test_preprocessing(self, pil_img, idx):
        img_100 = pil_img.resize(self.hr_size, Image.BICUBIC)
        img_100 = np.array(img_100).astype(np.float32) / 255.0

        if self.blur_type == "gaussian":
            img_blur = cv2.GaussianBlur(img_100, (0, 0), sigmaX=self.gaussian_sigma, sigmaY=self.gaussian_sigma)
        elif self.blur_type == "motion":
            theta = self.sample_theta(idx)
            kernel = self.motion_blur_kernel(self.motion_length, theta)
            img_blur = cv2.filter2D(img_100, -1, kernel)
        else:
            raise ValueError(f"Unsupported blur_type: {self.blur_type}")

        img_50 = cv2.resize(img_blur, self.fixed_lr_size, interpolation=cv2.INTER_CUBIC).astype(np.float32)
        return img_50

    def nn_preprocessing(self, img_50):
        img_48 = cv2.resize(img_50, self.nn_input_size, interpolation=cv2.INTER_CUBIC).astype(np.float32)
        return self.normalize(img_48)

    def sample_theta(self, idx):
        rng = random.Random(self.base_seed + idx)
        return rng.uniform(-math.pi, math.pi)

    def motion_blur_kernel(self, length, theta):
        length = max(1, int(length))
        kernel = np.zeros((length, length), dtype=np.float32)
        center = (length - 1) / 2.0
        x0 = center - (length - 1) / 2.0 * math.cos(theta)
        y0 = center - (length - 1) / 2.0 * math.sin(theta)
        x1 = center + (length - 1) / 2.0 * math.cos(theta)
        y1 = center + (length - 1) / 2.0 * math.sin(theta)

        cv2.line(
            kernel,
            (int(round(x0)), int(round(y0))),
            (int(round(x1)), int(round(y1))),
            1,
            thickness=1,
        )

        s = kernel.sum()
        if s > 0:
            kernel /= s
        else:
            kernel[length // 2, length // 2] = 1.0
        return kernel

    def normalize(self, img):
        z = (img - self.mean) / self.std
        return np.tanh(z).astype(np.float32)

    def denormalize(self, img: torch.Tensor):
        img = torch.clamp(img, -1.0 + self.eps, 1.0 - self.eps)
        mean = self.mean_torch.to(device=img.device, dtype=img.dtype)
        std = self.std_torch.to(device=img.device, dtype=img.dtype)
        z = torch.atanh(img)
        if img.ndim == 3:
            x = z * std + mean
        elif img.ndim == 4:
            x = z * std.unsqueeze(0) + mean.unsqueeze(0)
        else:
            raise ValueError(f"Unsupported tensor shape: {img.shape}")
        return torch.clamp(x, 0.0, 1.0)

#to evaluate the test set

def evaluate_one_test_setting(model, dataloader, dataset, device, criterion):
    model.eval()
    
    total_loss = 0.0
    total_psnr = 0.0
    total_ssim = 0.0
    total_batches = 0

    total_alpha_mean = 0.0
    total_alpha_min = 0.0
    total_alpha_max = 0.0

    with torch.no_grad():
        for iin, ih in dataloader:
            iin = iin.to(device).float()
            ih = ih.to(device).float()
            outputs, alpha = model(iin)

            loss = criterion(outputs, ih)
            pred = dataset.denormalize(outputs)
            target = dataset.denormalize(ih)

            total_loss += loss.item()
            total_psnr += psnr(pred, target).item()
            total_ssim += ssim_torch(pred, target).item()
            total_batches += 1

            total_alpha_mean += alpha.mean().item()
            total_alpha_min += alpha.min().item()
            total_alpha_max += alpha.max().item()

    avg_loss = total_loss / total_batches
    avg_psnr = total_psnr / total_batches
    avg_ssim = total_ssim / total_batches

    avg_alpha_mean = total_alpha_mean / total_batches
    avg_alpha_min = total_alpha_min / total_batches
    avg_alpha_max = total_alpha_max / total_batches

    print(
        f"[FINAL TEST] alpha mean: {avg_alpha_mean:.4f}, "
        f"min: {avg_alpha_min:.4f}, max: {avg_alpha_max:.4f}"
    )

    return avg_loss, avg_psnr, avg_ssim


#to run the test pipeline
def run_test_pipeline(mean, std, test_files: List[str], best_model_path: Path, device):
    criterion = nn.MSELoss()
    model = load_model(best_model_path, device)
    results = []

    for sigma in [1, 3, 5]:
        dataset = FixedTestFaceDataset(
            image_paths=test_files,
            mean=mean,
            std=std,
            blur_type="gaussian",
            gaussian_sigma=sigma,
        )
        loader = DataLoader(
            dataset,
            batch_size=BATCH_SIZE,
            shuffle=False,
            num_workers=NUM_WORKERS,
            pin_memory=torch.cuda.is_available(),
        )
        loss, score_psnr, score_ssim = evaluate_one_test_setting(model, loader, dataset, device, criterion)
        print(f"Gaussian sigma={sigma} | Loss={loss:.4f} | PSNR={score_psnr:.2f} dB | SSIM={score_ssim:.4f}")
        results.append({
            "blur_type": f"gaussian_sigma_{sigma}",
            "loss": loss,
            "psnr": score_psnr,
            "ssim": score_ssim,
        })

    for length in [2, 6, 9]:
        dataset = FixedTestFaceDataset(
            image_paths=test_files,
            mean=mean,
            std=std,
            blur_type="motion",
            motion_length=length,
            base_seed=SEED,
        )
        loader = DataLoader(
            dataset,
            batch_size=BATCH_SIZE,
            shuffle=False,
            num_workers=NUM_WORKERS,
            pin_memory=torch.cuda.is_available(),
        )
        loss, score_psnr, score_ssim = evaluate_one_test_setting(model, loader, dataset, device, criterion)
        print(f"Motion l={length} | Loss={loss:.4f} | PSNR={score_psnr:.2f} dB | SSIM={score_ssim:.4f}")
        results.append({
            "blur_type": f"motion_l_{length}_theta_random",
            "loss": loss,
            "psnr": score_psnr,
            "ssim": score_ssim,
        })

    test_csv = RESULTS_DIR / "test_pipeline_metrics.csv"
    with open(test_csv, "w", newline="", encoding="utf-8") as f:
        writer = csv.DictWriter(f, fieldnames=["blur_type", "loss", "psnr", "ssim"])
        writer.writeheader()
        writer.writerows(results)

    print(f"Saved test metrics to {test_csv}")

    sample_dataset = FixedTestFaceDataset(
        image_paths=test_files,
        mean=mean,
        std=std,
        blur_type="gaussian",
        gaussian_sigma=3,
    )
    save_sample_outputs(model, sample_dataset, device, RESULTS_DIR / "sample_outputs")
    return results


